{
  "name": "@clarivo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./app": "./app.ts"
  },
  "scripts": {
    "generate": "prisma contract emit && prisma contract emit --config prisma.app.config.ts",
    "typecheck": "pnpm generate && tsc --noEmit",
    "migration:plan": "prisma migration plan --config prisma.app.config.ts",
    "migration:show": "prisma migration show --config prisma.app.config.ts",
    "migration:deploy": "prisma db migrate --config prisma.app.config.ts"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "server-only": "^0.0.1",
    "@clarivo/shared": "workspace:*"
  },
  "devDependencies": {
    "prisma": "8.0.0-rc.22",
    "typescript": "^5",
    "@types/node": "^24"
  }
}
